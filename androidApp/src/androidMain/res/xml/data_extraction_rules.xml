<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for API 31+ (android:dataExtractionRules). Both cloud
  backup and device-to-device transfer exclude every data domain: the
  encrypted prefs (history, settings + the androidx.security keysets), files,
  databases. Nothing the app stores is meant to leave the device.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
