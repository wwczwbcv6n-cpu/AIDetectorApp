<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build override: allow cleartext HTTP for the local dev server.

  This file ONLY ships in debug variants (src/debug/...) — release builds
  use the default in src/androidMain/res/xml/network_security_config.xml
  which denies cleartext entirely. Manifest merger picks this one when
  building debug APKs.

  Localhost + 10.0.2.2 (Android emulator's host alias) are the typical
  dev-loop entries. Add specific LAN IPs here if you bind the server to
  one — never use a CIDR (DTD doesn't support them).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" /> <!-- so debug proxies (mitmproxy) work -->
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
